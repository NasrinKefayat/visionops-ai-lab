# Copy to .env at the repository root. Do not commit real secrets.
VISIONOPS_APP_NAME=VisionOps-AI
VISIONOPS_DATABASE_URL=sqlite:///./visionops.db
VISIONOPS_RANDOM_SEED=42
VISIONOPS_DEVICE=cpu
VISIONOPS_MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
VISIONOPS_MODEL_VERSION=untrained
VISIONOPS_API_PORT=8000

# CPU video tools; both executables must be installed separately.
VISIONOPS_FFMPEG_BINARY=ffmpeg
VISIONOPS_FFPROBE_BINARY=ffprobe
VISIONOPS_VIDEO_TIMEOUT_SECONDS=300

# Optional read-only dashboard publication. Use approved public/synthetic data only.
# Relative paths resolve from the backend process working directory.
# VISIONOPS_DATABASE_URL=sqlite:///./data/content-study/video.db
# VISIONOPS_DASHBOARD_MANIFEST=./data/content-study/manifest.json
# VISIONOPS_DASHBOARD_REPORTS=./artifacts/content-study
# VISIONOPS_DASHBOARD_MLFLOW_DIRECTORY=./mlruns/encoding-optimization
# Inference is off by default. Pin only administrator-trusted local joblib bytes.
# VISIONOPS_DASHBOARD_TRUSTED_MODELS={"study-uuid":"actual-64-character-sha256"}
